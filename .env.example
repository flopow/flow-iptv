# ─────────────────────────────────────────────────────────────
# FLOW IPTV — variáveis de ambiente (exemplo, SEM credenciais reais)
# Copie para .env.local e preencha apenas o que for usar.
# ─────────────────────────────────────────────────────────────

# ── Fonte de dados ─────────────────────────────────────────────
# "json"    → catálogo lido de data/catalog/*.json (funciona sem conta;
#             modo somente-leitura para o catálogo)
# "supabase"→ catálogo, autenticação e histórico no Supabase
DATA_SOURCE=json

# ── Supabase (obrigatório para DATA_SOURCE=supabase e para o painel) ──
# Crie o projeto em https://supabase.com e copie a URL e a chave anon
# (Project Settings → API). Rode supabase/migrations/0001_init.sql.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Usado APENAS no servidor (não exponha no navegador):
# SUPABASE_SERVICE_ROLE_KEY=

# ── TMDB — importação automática de capas/metadados (opcional) ──
# Chave de API v3: https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# Idioma padrão das buscas/descrições (ex.: pt-BR)
TMDB_LANGUAGE=pt-BR

# ── GitHub — repositório de capas/metadados pequenos (opcional) ──
# Token com escopo mínimo "repo" (conteúdo do repositório escolhido).
# Crie em https://github.com/settings/tokens
GITHUB_TOKEN=
# Ex.: seu-usuario/seu-repositorio
GITHUB_REPO=
# Branch usada (padrão "main")
GITHUB_BRANCH=main
# Caminho base no repositório (ex.: "public" ou "media")
GITHUB_MEDIA_PATH=public

# ── Repositório público do próprio site (exibido no rodapé) ──
NEXT_PUBLIC_SITE_REPO=

# ── Mídia local em desenvolvimento ─────────────────────────────
# Pasta onde vídeos locais são gravados. Se vazia, usa public/media.
MEDIA_ROOT=

# ── Importador de dramas (scripts/import-dramasite.mjs) ───────
# Caminho do ffmpeg/ffprobe (Windows): ex. C:/tools/ffmpeg/bin/ffmpeg.exe
FFMPEG=
FFPROBE=
# Caminho do rclone (usado no backend drive)
RCLONE=
# Backend dos vídeos: "github" (até 100 MB/arquivo) ou "drive"
# (Google Drive via rclone — 15–100 GB, streaming direto)
MEDIA_BACKEND=drive

# ── Domínios externos permitidos para vídeos por URL ───────────
# Lista separada por vírgula. Vazio desativa importação por URL.
ALLOWED_VIDEO_DOMAINS=
