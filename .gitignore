/baixados/
/baixados-teste/

# logs / sistema
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# logs locais de build/verificação
*.log

.vercel
